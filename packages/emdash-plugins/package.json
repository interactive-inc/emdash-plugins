{
  "name": "@interactive-inc/emdash-plugins",
  "version": "0.1.0",
  "description": "EmDash plugins by Interactive Inc. builder: chat-authored json-render pages, MCP tools and previews",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interactive-inc/emdash-plugins.git",
    "directory": "packages/emdash-plugins"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "astro",
    "json-render",
    "mcp",
    "page-builder"
  ],
  "type": "module",
  "exports": {
    "./builder": {
      "types": "./dist/builder/plugin.d.ts",
      "default": "./dist/builder/plugin.js"
    },
    "./builder/astro": {
      "types": "./dist/builder/astro.d.ts",
      "default": "./dist/builder/astro.js"
    },
    "./builder/server": {
      "types": "./dist/builder/server/page-response.d.ts",
      "default": "./dist/builder/server/page-response.js"
    },
    "./builder/document": {
      "types": "./dist/builder/document.d.ts",
      "default": "./dist/builder/document.js"
    },
    "./builder/catalog": {
      "types": "./dist/builder/catalog.d.ts",
      "default": "./dist/builder/catalog.js"
    },
    "./builder/runtime": {
      "types": "./dist/builder/runtime.d.ts",
      "default": "./dist/builder/runtime.js"
    },
    "./builder/renderer": "./src/builder/renderer.tsx",
    "./builder/admin": "./src/builder/admin.tsx",
    "./builder/PageShell.astro": "./src/builder/PageShell.astro",
    "./builder/styles.css": "./src/builder/styles/site.css",
    "./builder/middleware": {
      "types": "./dist/builder/middleware.d.ts",
      "default": "./dist/builder/middleware.js"
    },
    "./builder/extensions": {
      "types": "./dist/builder/extensions.d.ts",
      "default": "./dist/builder/extensions.js"
    }
  },
  "dependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@portabletext/react": "^6.0.0",
    "@portabletext/types": "^4.0.2",
    "motion": "14.9.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "astro": "^7.4.2",
    "emdash": "^1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --experimental-test-module-mocks --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "prepack": "vp run build"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "jsdom": "^30.1.3"
  }
}
