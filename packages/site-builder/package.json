{
  "name": "@open-emdash/site-builder",
  "version": "0.1.0",
  "description": "Chat-authored json-render pages, MCP tools and previews for EmDash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interactive-inc/open-emdash-home.git",
    "directory": "packages/site-builder"
  },
  "keywords": [
    "emdash",
    "emdash-plugin",
    "astro",
    "json-render",
    "mcp",
    "site-builder"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./astro": {
      "types": "./dist/astro.d.ts",
      "default": "./dist/astro.js"
    },
    "./server": {
      "types": "./dist/server/page-response.d.ts",
      "default": "./dist/server/page-response.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "default": "./dist/catalog.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./renderer": "./src/renderer.tsx",
    "./admin": "./src/admin.tsx",
    "./PageShell.astro": "./src/PageShell.astro",
    "./styles.css": "./src/styles/site.css",
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./extensions": {
      "types": "./dist/extensions.d.ts",
      "default": "./dist/extensions.js"
    }
  },
  "dependencies": {
    "@json-render/core": "0.21.3",
    "@json-render/react": "0.21.3",
    "@portabletext/react": "^6.0.0",
    "@portabletext/types": "^4.0.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "astro": "^7.4.2",
    "emdash": "^1.3.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts tests/*.test.tsx",
    "prepack": "vp run build"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
